# NutriMeasure AI Environment Configuration Example

# Flask Backend
FLASK_APP=run.py
FLASK_ENV=development
PORT=5000
SECRET_KEY=nutrimeasure-dev-secret-key-change-in-production-2026
JWT_SECRET_KEY=nutrimeasure-jwt-secret-key-change-in-production-2026
JWT_ACCESS_TOKEN_EXPIRES=86400

# Database (Default: SQLite local database)
DATABASE_URL=sqlite:///app.db

# Demo & Fallback Modes
# Set DEMO_MODE to true if ML model weights (.pt / .h5) are not present
DEMO_MODE=true
# Set CHATBOT_DEMO_MODE to true if external LLM API key is not configured
CHATBOT_DEMO_MODE=true

# AI / ML Model Paths
YOLO_MODEL_PATH=backend/app/ml/weights/yolov8_food.pt
EFFICIENTNET_MODEL_PATH=backend/app/ml/weights/efficientnet_food.h5

# LLM Chatbot Integration (Optional OpenAI integration)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-3.5-turbo

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
