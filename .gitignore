# Git ignore rules for NutriMeasure AI

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
ENV/

# Database & Uploads
backend/app.db
backend/*.db
backend/uploads/*
!backend/uploads/.gitkeep

# Models & Large Datasets
backend/app/ml/weights/*
!backend/app/ml/weights/.gitkeep
ml/models/yolov8/*
ml/models/efficientnet/*
!ml/models/yolov8/.gitkeep
!ml/models/efficientnet/.gitkeep

# Node / React
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
.eslintcache

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Output archives
*.zip

# Vite temp
frontend/vite.config.ts.timestamp-*.mjs
